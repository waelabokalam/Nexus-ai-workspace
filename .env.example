# Public website configuration. Use your real domain before deployment.
NEXT_PUBLIC_SITE_URL=https://your-domain.com
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com

# Restaurant V1 Supabase project. The publishable key is safe for browser use;
# organization isolation is enforced by Row Level Security.
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-publishable-key

# Server-only. Reserved for trusted event ingestion and explicit admin tooling.
# Never prefix this value with NEXT_PUBLIC_ or import it into client components.
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key

# Server-only support-demo configuration. Never expose this key to the browser.
NEXUS_BACKEND_URL=http://127.0.0.1:8000
NEXUS_DEVELOPMENT_API_KEY=replace-with-local-backend-key

# Server-only URL and shared token for the isolated PP-StructureV3 service.
NEXUS_INVOICE_OCR_URL=http://invoice-ocr.internal:8080
NEXUS_INVOICE_OCR_TOKEN=replace-with-a-long-random-shared-token
