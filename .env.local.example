# Public website configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com

# Restaurant V1 local Supabase configuration
NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=replace-with-local-publishable-key

# Server-only and optional for trusted local ingestion/admin scripts.
SUPABASE_SERVICE_ROLE_KEY=replace-with-local-service-role-key

# Server-only support-demo configuration
NEXUS_BACKEND_URL=http://127.0.0.1:8000
NEXUS_DEVELOPMENT_API_KEY=replace-with-local-backend-key

# Server-only automatic supplier-invoice extraction service.
NEXUS_INVOICE_OCR_URL=http://127.0.0.1:8080
NEXUS_INVOICE_OCR_TOKEN=replace-with-a-long-random-shared-token
