# Public website configuration
NEXT_PUBLIC_SITE_URL=http://localhost:3000
NEXT_PUBLIC_CONTACT_EMAIL=hello@your-domain.com

# Server-only support-demo configuration
NEXUS_BACKEND_URL=http://127.0.0.1:8000
NEXUS_DEVELOPMENT_API_KEY=replace-with-local-backend-key

# Server-only lead storage. Never prefix the service role key with NEXT_PUBLIC_.
SUPABASE_URL=https://your-project.supabase.co
SUPABASE_SERVICE_ROLE_KEY=replace-with-server-only-service-role-key
